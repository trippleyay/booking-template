# ============================================================
# ENVIRONMENT VARIABLES — copy this file to .env and fill in
# ============================================================
# Never commit .env. Every variable below is required: the server
# refuses to start and lists what is missing if any are absent.
# ============================================================

# --- Supabase ---
# Found in: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...          # Safe to expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # NEVER expose — server only

# --- Stripe ---
# Found in: dashboard.stripe.com > Developers > API keys
# Use TEST mode keys while developing (sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret.
# Local: printed by `npm run stripe:listen`
# Deployed: Stripe dashboard > Webhooks > your endpoint > Signing secret
# These are DIFFERENT values — the local one only works with the CLI.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend ---
# Found in: resend.com > API Keys
RESEND_API_KEY=re_...

# Must be an address on a domain you have verified with Resend,
# otherwise every email silently fails to deliver.
RESEND_FROM_EMAIL=bookings@lumestudio.com

# --- Admin ---
# The only email allowed into /admin. Must match a user you created
# in Supabase dashboard > Authentication > Users.
ADMIN_EMAIL=admin@lumestudio.com

# --- Server ---
PORT=3001

# Where the app is reachable from a browser. Used for Stripe redirect
# URLs, email links, and as the allowed CORS origin in production.
# Local dev: http://localhost:5173  (the Vite dev server)
# Deployed:  https://your-app.replit.app
PUBLIC_URL=http://localhost:5173

# ============================================================
# CLIENT-SIDE (must be prefixed VITE_ to reach the browser)
# ============================================================

# Supabase auth for the admin login screen. The anon key is safe to
# expose — Row Level Security grants it no access to any table.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Leave EMPTY unless the API is on a different origin to the frontend.
# In dev, Vite proxies /api to the backend; in production the same Hono
# process serves both. Setting this to localhost would be baked into your
# production build and break the deployed site.
VITE_API_URL=
